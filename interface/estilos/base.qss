/* --- Estrutura e Container --- */
QWidget {
    background-color: transparent;
    font-family: "Segoe UI";
}

#sidebar {
    border-right-width: 1px;
    border-right-style: solid;
}

#marca_sidebar {
    font-size: 30px;
    font-weight: 800;
    letter-spacing: 2px;
}

#subtitulo_sidebar {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
}

#titulo_menu {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
}

#menu_btn,
#ajuda_btn {
    min-height: 24px;
    padding: 12px 14px;
    border: 1px solid transparent;
    border-radius: 10px;
    text-align: left;
    font-size: 14px;
    font-weight: 600;
}

#menu_btn:focus,
#ajuda_btn:focus {
    border-width: 2px;
    border-style: solid;
}

#divisor_sidebar {
    border: none;
}

#scroll_pagina {
    border: none;
}

#rotulo_pagina {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
}

#titulo_pagina {
    font-size: 30px;
    font-weight: 700;
}

#subtitulo_pagina {
    font-size: 15px;
}

#card_comando {
    border-width: 1px;
    border-style: solid;
    border-radius: 16px;
}

#icone_comando {
    border-radius: 9px;
    font-size: 11px;
    font-weight: 800;
}

#titulo_card_comando {
    font-size: 17px;
    font-weight: 700;
}

#descricao_card_comando,
#exemplo_comando {
    font-size: 13px;
}

#exemplo_comando {
    font-style: italic;
}

#ordem_historico,
#botao_atualizar_historico,
#botao_limpar_historico {
    min-height: 20px;
    padding: 9px 14px;
    border-width: 1px;
    border-style: solid;
    border-radius: 10px;
}

#ordem_historico {
    min-width: 180px;
    padding-right: 38px;
}

#ordem_historico::drop-down {
    width: 36px;
    border: none;
    background-color: transparent;
}

#ordem_historico::down-arrow {
    width: 12px;
    height: 8px;
}

#resumo_historico {
    font-size: 13px;
    font-weight: 600;
}

#lista_historico {
    border-width: 1px;
    border-style: solid;
    border-radius: 16px;
    padding: 10px;
    outline: none;
}

#lista_historico::item {
    border: none;
}

#item_historico {
    border-width: 1px;
    border-style: solid;
    border-radius: 12px;
}

#comando_historico {
    font-size: 15px;
    font-weight: 600;
}

#data_historico,
#estado_historico {
    font-size: 13px;
}

#botao_excluir_historico {
    min-width: 68px;
    padding: 8px 12px;
    border-width: 1px;
    border-style: solid;
    border-radius: 9px;
}

#lista_historico QScrollBar:vertical {
    width: 10px;
    margin: 6px 2px;
    border: none;
    background: transparent;
}

#lista_historico QScrollBar::handle:vertical {
    min-height: 36px;
    border-radius: 4px;
}

#lista_historico QScrollBar::add-line:vertical,
#lista_historico QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
    background: transparent;
}

#lista_historico QScrollBar::add-page:vertical,
#lista_historico QScrollBar::sub-page:vertical {
    background: transparent;
}

#login_card {
    border-radius: 20px;
    border: 1px solid #334155;
    /* A cor de fundo será definida no seu tema (escuro.qss/claro.qss) */
}

/* --- Tipografia e Títulos (Forçando transparência) --- */
QLabel {
    background-color: transparent;
    border: none;
}

#logo_login { 
    font-size: 50px; 
    margin-bottom: 10px; 
    background-color: transparent;
}

#titulo_login { 
    font-weight: bold; 
    margin-bottom: 5px; 
    background-color: transparent;
}

#subtitulo_login { 
    margin-bottom: 20px; 
    color: #94A3B8;
    background-color: transparent;
}

/* Título das telas secundárias (Cadastro, Recuperação, etc.) */
#titulo_tela {
    font-weight: bold;
    margin-bottom: 15px;
    background-color: transparent;
}

#descricao_tela {
    color: #94A3B8;
    margin-bottom: 10px;
    background-color: transparent;
}

#label_input { 
    font-weight: 600; 
    margin-top: 10px; 
    margin-bottom: 5px; 
    background-color: transparent;
}

#ajuda_input {
    color: #94A3B8;
    margin-top: -4px;
    margin-bottom: 8px;
    background-color: transparent;
}

/* --- Campos de Entrada --- */
QLineEdit {
    padding: 12px;
    border-radius: 8px;
    border: 1px solid #334155;
}

/* --- Botões --- */
QPushButton {
    padding: 12px;
    border-radius: 8px;
    font-weight: bold;
    border: none;
}

#btn_secundario {
    background-color: transparent;
    border: 1px solid #475569;
}

#btn_link {
    background-color: transparent;
    text-decoration: underline;
    font-size: 12px;
    margin-top: 5px;
}

/* --- Status --- */
#status_msg {
    font-weight: bold;
    margin-top: 10px;
    background-color: transparent;
}

QToolButton {
    background-color: transparent;
    border: 1px solid #334155;
    border-radius: 8px;
}

QToolButton:hover {
    background-color: #334155;
}

QToolButton:focus {
    border: 2px solid #FACC15;
}
