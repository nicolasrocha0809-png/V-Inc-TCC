/* Fundo Geral  */
QWidget {
    background-color: #07162B;
    color: #F2F7FF;
}

QLabel {
    background-color: transparent;
}

#sidebar {
    background-color: #0B1F3A;
    border-right-color: #21456F;
}

#marca_sidebar { color: #A9D2FF; }
#subtitulo_sidebar { color: #83A7CE; }
#titulo_menu { color: #83A7CE; }

#menu_btn,
#ajuda_btn {
    background-color: transparent;
    color: #C7D8EC;
}

#menu_btn:hover,
#ajuda_btn:hover {
    background-color: #12345A;
    color: #F2F7FF;
}

#menu_btn:checked,
#ajuda_btn:checked {
    background-color: #20539B;
    color: #FFFFFF;
}

#menu_btn:focus,
#ajuda_btn:focus {
    border-color: #8FC5FF;
}

#divisor_sidebar { background-color: #21456F; }

#pagina_conta,
#conteudo_conta { background-color: #07162B; }
#card_conta {
    background-color: #102A4C;
    border-color: #21456F;
}
#card_perigo_conta {
    background-color: #2C1D2A;
    border-color: #8A4B55;
}
#titulo_card_conta, #label_conta { color: #F2F7FF; }
#descricao_card_conta { color: #AFC3DC; }
#email_conta, #status_conta { color: #8FC5FF; }
#status_conta[erro="true"],
#status_perigo_conta { color: #FFB4AB; }
#campo_conta {
    background-color: #16385F;
    color: #F2F7FF;
    border-color: #476D9C;
}
#campo_conta:focus { border-color: #8FC5FF; }
#botao_mostrar_senha_conta,
#botao_sair_conta {
    background-color: transparent;
    color: #A9D2FF;
    border-color: #476D9C;
}
#botao_mostrar_senha_conta:hover,
#botao_sair_conta:hover { background-color: #16385F; }
#botao_primario_conta {
    background-color: #A9D2FF;
    color: #07162B;
    border-color: #A9D2FF;
}
#botao_primario_conta:hover { background-color: #8FC5FF; }
#botao_excluir_conta {
    background-color: transparent;
    color: #FFB4AB;
    border-color: #B65E59;
}
#botao_excluir_conta:hover { background-color: #5A2528; }
#scroll_conta QScrollBar::handle:vertical { background-color: #476D9C; }
#scroll_conta QScrollBar::handle:vertical:hover { background-color: #8FC5FF; }

#pagina_comandos { background-color: #07162B; }
#rotulo_pagina { color: #8FC5FF; }
#titulo_pagina { color: #F2F7FF; }
#subtitulo_pagina { color: #AFC3DC; }
#card_comando {
    background-color: #102A4C;
    border-color: #21456F;
}
#card_comando:hover { border-color: #5C8FC8; }
#icone_comando { background-color: #20539B; color: #FFFFFF; }
#titulo_card_comando { color: #F2F7FF; }
#descricao_card_comando { color: #C7D8EC; }
#exemplo_comando { color: #8FC5FF; }

#pagina_historico { background-color: #07162B; }
#ordem_historico,
#botao_atualizar_historico {
    background-color: #16385F;
    color: #F2F7FF;
    border-color: #476D9C;
}
#ordem_historico:hover,
#botao_atualizar_historico:hover { background-color: #20539B; }
#ordem_historico::down-arrow {
    image: url(interface/assets/chevron_down_dark.svg);
}
#botao_atualizar_historico:disabled { color: #83A7CE; }
#botao_limpar_historico,
#botao_excluir_historico {
    background-color: transparent;
    color: #FFB4AB;
    border-color: #B65E59;
}
#botao_limpar_historico:hover,
#botao_excluir_historico:hover { background-color: #5A2528; }
#resumo_historico, #data_historico { color: #8FC5FF; }
#conteudo_historico, #lista_historico {
    background-color: #0B1F3A;
    border-color: #21456F;
}
#item_historico {
    background-color: #102A4C;
    border-color: #21456F;
}
#comando_historico { color: #F2F7FF; }
#estado_historico { color: #AFC3DC; }
#lista_historico QScrollBar::handle:vertical { background-color: #476D9C; }
#lista_historico QScrollBar::handle:vertical:hover { background-color: #8FC5FF; }

#pagina_configuracoes,
#conteudo_configuracoes { background-color: #07162B; }
#card_configuracao {
    background-color: #102A4C;
    border-color: #21456F;
}
#titulo_card_configuracao, #label_configuracao { color: #F2F7FF; }
#descricao_card_configuracao { color: #AFC3DC; }
#campo_configuracao {
    background-color: #16385F;
    color: #F2F7FF;
    border-color: #476D9C;
}
#campo_configuracao:hover, #campo_configuracao:focus {
    border-color: #8FC5FF;
}
#campo_configuracao::down-arrow {
    image: url(interface/assets/chevron_down_dark.svg);
}
#campo_configuracao QAbstractItemView {
    background-color: #102A4C;
    color: #F2F7FF;
    selection-background-color: #20539B;
    selection-color: #FFFFFF;
    border: 1px solid #476D9C;
}
#valor_configuracao { color: #8FC5FF; }
#slider_configuracao::groove:horizontal { background-color: #16385F; }
#slider_configuracao::sub-page:horizontal { background-color: #20539B; }
#slider_configuracao::handle:horizontal {
    background-color: #A9D2FF;
    border-color: #07162B;
}
#botao_secundario_configuracoes {
    background-color: transparent;
    color: #A9D2FF;
    border-color: #476D9C;
}
#botao_secundario_configuracoes:hover { background-color: #16385F; }
#botao_salvar_configuracoes {
    background-color: #A9D2FF;
    color: #07162B;
    border-color: #A9D2FF;
}
#botao_salvar_configuracoes:hover { background-color: #8FC5FF; }
#botao_salvar_configuracoes:disabled { background-color: #476D9C; }
#status_configuracoes { color: #8FC5FF; }
#scroll_configuracoes QScrollBar::handle:vertical {
    background-color: #476D9C;
}
#scroll_configuracoes QScrollBar::handle:vertical:hover {
    background-color: #8FC5FF;
}

#pagina_inicio, #conteudo_inicio { background-color: #07162B; }
#estado_assistente { color: #A9D2FF; }
#botao_microfone {
    background-color: #A9D2FF;
    color: #07162B;
    border-color: #07162B;
}
#botao_microfone:hover { background-color: #8FC5FF; }
#card_audio_inicio {
    background-color: #102A4C;
    border-color: #476D9C;
}
#titulo_campo_audio { color: #F2F7FF; }
#campo_audio_inicio {
    background-color: #16385F;
    color: #F2F7FF;
    border-color: #476D9C;
}
#campo_audio_inicio:hover, #campo_audio_inicio:focus {
    border-color: #A9D2FF;
}
#campo_audio_inicio::down-arrow {
    image: url(interface/assets/chevron_down_dark.svg);
}
#campo_audio_inicio QAbstractItemView {
    background-color: #102A4C;
    color: #F2F7FF;
    selection-background-color: #20539B;
    selection-color: #FFFFFF;
    border: 1px solid #476D9C;
}
#divisor_audio_inicio { background-color: #476D9C; border: none; }
#botao_iniciar_assistente {
    background-color: #A9D2FF;
    color: #07162B;
    border-color: #A9D2FF;
}
#botao_iniciar_assistente:hover { background-color: #8FC5FF; }
#botao_configuracoes_voz {
    background-color: transparent;
    color: #A9D2FF;
    border-color: #A9D2FF;
}
#botao_configuracoes_voz:hover { background-color: #16385F; }

/* Card de Login - */
#login_card {
    background-color: #102A4C;
    border: 1px solid #21456F;
}
#login_card * {
    background-color: transparent;
}

#logo_login { color: #A9D2FF; }
#titulo_login { color: #FFFFFF; }
#subtitulo_login { color: #94A3B8; }

#label_input { color: #E2E8F0; }


QLineEdit {
    background-color: #0B1F3A;
    color: #F2F7FF;
    border-color: #476D9C;
}

QLineEdit:focus {
    border-color: #8FC5FF;
}

/* Botão de Entrar  */
#btn_entrar {
    background-color: #20539B;
    color: #FFFFFF;
}

#btn_entrar:hover {
    background-color: #2B68B8;
}

/* Botões Secundários */
#btn_secundario {
    background-color: transparent;
    border: 1px solid #475569;
    color: #F1F5F9;
}

#btn_secundario:hover {
    background-color: #334155;
}

#btn_link {
    color: #94A3B8;
}

#btn_link:hover {
    color: #F1F5F9;
}

/* Mensagens de erro*/
#status_msg {
    color: #F87171; 
}

/* --- Central de ajuda --- */
#pagina_ajuda,
#conteudo_ajuda {
    background-color: #07162B;
}

#botao_atalho_ajuda {
    background-color: #16385F;
    color: #F2F7FF;
    border-color: #476D9C;
}

#botao_atalho_ajuda:hover {
    background-color: #20539B;
}

#card_pergunta {
    background-color: #102A4C;
    border-color: #21456F;
}

#botao_pergunta {
    background-color: transparent;
    color: #F2F7FF;
}

#botao_pergunta:hover,
#botao_pergunta:checked {
    background-color: #16385F;
    color: #A9D2FF;
}

#resposta_pergunta {
    color: #C7D8EC;
}

#card_suporte {
    background-color: #102A4C;
    border-color: #476D9C;
}

#titulo_suporte { color: #F2F7FF; }
#texto_suporte { color: #AFC3DC; }

#botao_copiar_suporte {
    background-color: #A9D2FF;
    color: #07162B;
    border-color: #A9D2FF;
}

#botao_copiar_suporte:hover {
    background-color: #8FC5FF;
}

#scroll_ajuda QScrollBar::handle:vertical {
    background-color: #476D9C;
}

#scroll_ajuda QScrollBar::handle:vertical:hover {
    background-color: #8FC5FF;
}

/* --- Autenticação --- */
#pagina_login,
#login_scroll_area,
#card_container {
    background-color: #07162B;
}

#painel_login,
#cadastro_card,
#container_secundario {
    background-color: #102A4C;
    border-color: #21456F;
}

#titulo_login, #marca_cadastro { color: #A9D2FF; }
#subtitulo_login { color: #8FC5FF; }
#titulo_form_login, #titulo_tela { color: #F2F7FF; }
#descricao_form_login, #descricao_tela, #ajuda_input { color: #AFC3DC; }
#pagina_login #label_input { color: #E3EEFC; }

#pagina_login QLineEdit {
    background-color: #0B1F3A;
    color: #F2F7FF;
    border-color: #476D9C;
    selection-background-color: #20539B;
}

#pagina_login QLineEdit:focus { border-color: #8FC5FF; }

#pagina_login QToolButton {
    background-color: #0B1F3A;
    color: #A9D2FF;
    border-color: #476D9C;
}

#pagina_login QToolButton:hover { background-color: #16385F; }

#pagina_login #btn_entrar {
    background-color: #A9D2FF;
    color: #07162B;
    border-color: #A9D2FF;
}

#pagina_login #btn_entrar:hover {
    background-color: #8FC5FF;
    border-color: #8FC5FF;
}

#pagina_login #btn_secundario {
    background-color: transparent;
    color: #F2F7FF;
    border-color: #476D9C;
}

#pagina_login #btn_secundario:hover { background-color: #16385F; }
#pagina_login #btn_link { color: #A9D2FF; }
#pagina_login #btn_link:hover { color: #FFFFFF; }

#campo_cadastro {
    background-color: #0B1F3A;
    border-color: #476D9C;
}

#campo_cadastro:focus-within { border-color: #8FC5FF; }
#status_msg { color: #FF9A9A; }

#login_scroll_area QScrollBar::handle:vertical { background-color: #476D9C; }
#login_scroll_area QScrollBar::handle:vertical:hover { background-color: #8FC5FF; }

/* --- Carregamento --- */
#pagina_loading { background-color: #07162B; }
#card_loading {
    background-color: #102A4C;
    border-color: #21456F;
}
#titulo_loading, #status_loading { color: #F2F7FF; }
#subtitulo_loading, #percentual_loading { color: #A9D2FF; }
#modulos_loading { color: #AFC3DC; }
#barra_loading {
    background-color: #0B1F3A;
    border-color: #476D9C;
}
#barra_loading::chunk { background-color: #A9D2FF; }
