/* Fundo Geral  */
QWidget {
    background-color: #07162B;
    color: #F2F7FF;
}

QLabel {
    background-color: transparent;
}

#sidebar {
    background-color: #0B1F3A;
    border-right-color: #21456F;
}

#marca_sidebar { color: #A9D2FF; }
#subtitulo_sidebar { color: #83A7CE; }
#titulo_menu { color: #83A7CE; }

#menu_btn,
#ajuda_btn {
    background-color: transparent;
    color: #C7D8EC;
}

#menu_btn:hover,
#ajuda_btn:hover {
    background-color: #12345A;
    color: #F2F7FF;
}

#menu_btn:checked,
#ajuda_btn:checked {
    background-color: #20539B;
    color: #FFFFFF;
}

#menu_btn:focus,
#ajuda_btn:focus {
    border-color: #8FC5FF;
}

#divisor_sidebar { background-color: #21456F; }

#pagina_comandos { background-color: #07162B; }
#rotulo_pagina { color: #8FC5FF; }
#titulo_pagina { color: #F2F7FF; }
#subtitulo_pagina { color: #AFC3DC; }
#card_comando {
    background-color: #102A4C;
    border-color: #21456F;
}
#card_comando:hover { border-color: #5C8FC8; }
#icone_comando { background-color: #20539B; color: #FFFFFF; }
#titulo_card_comando { color: #F2F7FF; }
#descricao_card_comando { color: #C7D8EC; }
#exemplo_comando { color: #8FC5FF; }

/* Card de Login - */
#login_card {
    background-color: #102A4C;
    border: 1px solid #21456F;
}
#login_card * {
    background-color: transparent;
}

#logo_login { color: #A9D2FF; }
#titulo_login { color: #FFFFFF; }
#subtitulo_login { color: #94A3B8; }

#label_input { color: #E2E8F0; }


QLineEdit {
    background-color: #0B1F3A;
    color: #F2F7FF;
    border-color: #476D9C;
}

QLineEdit:focus {
    border-color: #8FC5FF;
}

/* Botão de Entrar  */
#btn_entrar {
    background-color: #20539B;
    color: #FFFFFF;
}

#btn_entrar:hover {
    background-color: #2B68B8;
}

/* Botões Secundários */
#btn_secundario {
    background-color: transparent;
    border: 1px solid #475569;
    color: #F1F5F9;
}

#btn_secundario:hover {
    background-color: #334155;
}

#btn_link {
    color: #94A3B8;
}

#btn_link:hover {
    color: #F1F5F9;
}

/* Mensagens de erro*/
#status_msg {
    color: #F87171; 
}
