
QWidget { background-color: #F7F9FA; color: #182022; }
QLabel { background-color: transparent; }

#sidebar { background-color: #FFFFFF; border-right-color: #D8E0E3; }
#marca_sidebar { color: #20539B; }
#subtitulo_sidebar, #titulo_menu { color: #586569; }
#menu_btn, #ajuda_btn { background-color: transparent; color: #344347; }
#menu_btn:hover, #ajuda_btn:hover { background-color: #E8F3F7; color: #182022; }
#menu_btn:checked, #ajuda_btn:checked { background-color: #20539B; color: #FFFFFF; }
#menu_btn:focus, #ajuda_btn:focus { border-color: #20539B; }
#divisor_sidebar { background-color: #D8E0E3; }

#pagina_comandos { background-color: #F7F9FA; }
#rotulo_pagina { color: #20539B; }
#titulo_pagina { color: #182022; }
#subtitulo_pagina { color: #586569; }
#card_comando { background-color: #FFFFFF; border-color: #D8E0E3; }
#card_comando:hover { border-color: #20539B; }
#icone_comando { background-color: #D8E9FF; color: #173F78; }
#titulo_card_comando { color: #182022; }
#descricao_card_comando { color: #46575C; }
#exemplo_comando { color: #20539B; }

#pagina_historico { background-color: #F7F9FA; }
#ordem_historico,
#botao_atualizar_historico {
    background-color: #FFFFFF;
    color: #173F78;
    border-color: #AAB5B9;
}
#ordem_historico:hover,
#botao_atualizar_historico:hover { background-color: #D8E9FF; }
#ordem_historico::down-arrow {
    image: url(interface/assets/chevron_down_light.svg);
}
#botao_atualizar_historico:disabled { color: #7B898E; }
#botao_limpar_historico,
#botao_excluir_historico {
    background-color: #FFFFFF;
    color: #9C2F2B;
    border-color: #C87772;
}
#botao_limpar_historico:hover,
#botao_excluir_historico:hover { background-color: #FFE8E6; }
#resumo_historico, #data_historico { color: #20539B; }
#conteudo_historico, #lista_historico {
    background-color: #FFFFFF;
    border-color: #D8E0E3;
}
#item_historico {
    background-color: #F7F9FA;
    border-color: #D8E0E3;
}
#comando_historico { color: #182022; }
#estado_historico { color: #586569; }
#lista_historico QScrollBar::handle:vertical { background-color: #AAB5B9; }
#lista_historico QScrollBar::handle:vertical:hover { background-color: #20539B; }

#login_card { background-color: #FFFFFF; border-color: #D8E0E3; }
QLineEdit { background-color: #FFFFFF; color: #182022; border-color: #AAB5B9; }

#btn_entrar { background-color: #20539B; color: #FFFFFF; }
#btn_entrar:hover { background-color: #173F78; }

#subtitulo_login { color: #586569; }
#logo_login { color: #20539B; }
