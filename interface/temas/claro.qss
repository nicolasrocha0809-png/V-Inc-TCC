
QWidget { background-color: #F7F9FA; color: #182022; }
QLabel { background-color: transparent; }

#sidebar { background-color: #FFFFFF; border-right-color: #D8E0E3; }
#marca_sidebar { color: #20539B; }
#subtitulo_sidebar, #titulo_menu { color: #586569; }
#menu_btn, #ajuda_btn { background-color: transparent; color: #344347; }
#menu_btn:hover, #ajuda_btn:hover { background-color: #E8F3F7; color: #182022; }
#menu_btn:checked, #ajuda_btn:checked { background-color: #20539B; color: #FFFFFF; }
#menu_btn:focus, #ajuda_btn:focus { border-color: #20539B; }
#divisor_sidebar { background-color: #D8E0E3; }

#pagina_comandos { background-color: #F7F9FA; }
#rotulo_pagina { color: #20539B; }
#titulo_pagina { color: #182022; }
#subtitulo_pagina { color: #586569; }
#card_comando { background-color: #FFFFFF; border-color: #D8E0E3; }
#card_comando:hover { border-color: #20539B; }
#icone_comando { background-color: #D8E9FF; color: #173F78; }
#titulo_card_comando { color: #182022; }
#descricao_card_comando { color: #46575C; }
#exemplo_comando { color: #20539B; }

#pagina_historico { background-color: #F7F9FA; }
#ordem_historico,
#botao_atualizar_historico {
    background-color: #FFFFFF;
    color: #173F78;
    border-color: #AAB5B9;
}
#ordem_historico:hover,
#botao_atualizar_historico:hover { background-color: #D8E9FF; }
#ordem_historico::down-arrow {
    image: url(interface/assets/chevron_down_light.svg);
}
#botao_atualizar_historico:disabled { color: #7B898E; }
#botao_limpar_historico,
#botao_excluir_historico {
    background-color: #FFFFFF;
    color: #9C2F2B;
    border-color: #C87772;
}
#botao_limpar_historico:hover,
#botao_excluir_historico:hover { background-color: #FFE8E6; }
#resumo_historico, #data_historico { color: #20539B; }
#conteudo_historico, #lista_historico {
    background-color: #FFFFFF;
    border-color: #D8E0E3;
}
#item_historico {
    background-color: #F7F9FA;
    border-color: #D8E0E3;
}
#comando_historico { color: #182022; }
#estado_historico { color: #586569; }
#lista_historico QScrollBar::handle:vertical { background-color: #AAB5B9; }
#lista_historico QScrollBar::handle:vertical:hover { background-color: #20539B; }

#pagina_configuracoes,
#conteudo_configuracoes { background-color: #F7F9FA; }
#card_configuracao {
    background-color: #FFFFFF;
    border-color: #D8E0E3;
}
#titulo_card_configuracao, #label_configuracao { color: #182022; }
#descricao_card_configuracao { color: #586569; }
#campo_configuracao {
    background-color: #FFFFFF;
    color: #182022;
    border-color: #AAB5B9;
}
#campo_configuracao:hover, #campo_configuracao:focus {
    border-color: #20539B;
}
#campo_configuracao::down-arrow {
    image: url(interface/assets/chevron_down_light.svg);
}
#campo_configuracao QAbstractItemView {
    background-color: #FFFFFF;
    color: #182022;
    selection-background-color: #D8E9FF;
    selection-color: #173F78;
    border: 1px solid #AAB5B9;
}
#valor_configuracao { color: #20539B; }
#slider_configuracao::groove:horizontal { background-color: #D8E0E3; }
#slider_configuracao::sub-page:horizontal { background-color: #20539B; }
#slider_configuracao::handle:horizontal {
    background-color: #FFFFFF;
    border-color: #20539B;
}
#botao_secundario_configuracoes {
    background-color: #FFFFFF;
    color: #173F78;
    border-color: #AAB5B9;
}
#botao_secundario_configuracoes:hover { background-color: #D8E9FF; }
#botao_salvar_configuracoes {
    background-color: #20539B;
    color: #FFFFFF;
    border-color: #20539B;
}
#botao_salvar_configuracoes:hover { background-color: #173F78; }
#botao_salvar_configuracoes:disabled { background-color: #AAB5B9; }
#status_configuracoes { color: #20539B; }
#scroll_configuracoes QScrollBar::handle:vertical {
    background-color: #AAB5B9;
}
#scroll_configuracoes QScrollBar::handle:vertical:hover {
    background-color: #20539B;
}

#pagina_inicio, #conteudo_inicio { background-color: #F7F9FA; }
#estado_assistente { color: #20539B; }
#botao_microfone {
    background-color: #D8E9FF;
    color: #173F78;
    border-color: #173F78;
}
#botao_microfone:hover { background-color: #B9D8FF; }
#card_audio_inicio {
    background-color: #FFFFFF;
    border-color: #D8E0E3;
}
#titulo_campo_audio { color: #182022; }
#campo_audio_inicio {
    background-color: #F7F9FA;
    color: #182022;
    border-color: #AAB5B9;
}
#campo_audio_inicio:hover, #campo_audio_inicio:focus {
    border-color: #20539B;
}
#campo_audio_inicio::down-arrow {
    image: url(interface/assets/chevron_down_light.svg);
}
#campo_audio_inicio QAbstractItemView {
    background-color: #FFFFFF;
    color: #182022;
    selection-background-color: #D8E9FF;
    selection-color: #173F78;
    border: 1px solid #AAB5B9;
}
#divisor_audio_inicio { background-color: #D8E0E3; border: none; }
#botao_iniciar_assistente {
    background-color: #20539B;
    color: #FFFFFF;
    border-color: #20539B;
}
#botao_iniciar_assistente:hover { background-color: #173F78; }
#botao_configuracoes_voz {
    background-color: transparent;
    color: #173F78;
    border-color: #20539B;
}
#botao_configuracoes_voz:hover { background-color: #D8E9FF; }

#login_card { background-color: #FFFFFF; border-color: #D8E0E3; }
QLineEdit { background-color: #FFFFFF; color: #182022; border-color: #AAB5B9; }

#btn_entrar { background-color: #20539B; color: #FFFFFF; }
#btn_entrar:hover { background-color: #173F78; }

#subtitulo_login { color: #586569; }
#logo_login { color: #20539B; }

/* --- Central de ajuda --- */
#pagina_ajuda,
#conteudo_ajuda {
    background-color: #F7F9FA;
}

#botao_atalho_ajuda {
    background-color: #FFFFFF;
    color: #173F78;
    border-color: #AAB5B9;
}

#botao_atalho_ajuda:hover {
    background-color: #D8E9FF;
    border-color: #20539B;
}

#card_pergunta {
    background-color: #FFFFFF;
    border-color: #D8E0E3;
}

#botao_pergunta {
    background-color: transparent;
    color: #182022;
}

#botao_pergunta:hover,
#botao_pergunta:checked {
    background-color: #D8E9FF;
    color: #173F78;
}

#resposta_pergunta {
    color: #46575C;
}

#card_suporte {
    background-color: #FFFFFF;
    border-color: #D8E0E3;
}

#titulo_suporte { color: #182022; }
#texto_suporte { color: #586569; }

#botao_copiar_suporte {
    background-color: #20539B;
    color: #FFFFFF;
    border-color: #20539B;
}

#botao_copiar_suporte:hover {
    background-color: #173F78;
}

#scroll_ajuda QScrollBar::handle:vertical {
    background-color: #AAB5B9;
}

#scroll_ajuda QScrollBar::handle:vertical:hover {
    background-color: #20539B;
}
