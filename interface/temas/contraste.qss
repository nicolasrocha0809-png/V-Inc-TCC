
QWidget { background-color: #000000; color: #FFFF00; }
QLabel { background-color: transparent; }

#sidebar { background-color: #000000; border-right-color: #FFFF00; }
#marca_sidebar, #subtitulo_sidebar, #titulo_menu { color: #FFFF00; }
#menu_btn, #ajuda_btn { background-color: #000000; color: #FFFF00; }
#menu_btn:hover, #menu_btn:checked, #ajuda_btn:hover, #ajuda_btn:checked {
    background-color: #FFFF00;
    color: #000000;
}
#menu_btn:focus, #ajuda_btn:focus { border-color: #FFFFFF; }
#divisor_sidebar { background-color: #FFFF00; }

#pagina_comandos { background-color: #000000; }
#rotulo_pagina, #titulo_pagina, #subtitulo_pagina,
#titulo_card_comando, #descricao_card_comando, #exemplo_comando {
    color: #FFFF00;
}
#card_comando { background-color: #000000; border-color: #FFFF00; }
#icone_comando { background-color: #FFFF00; color: #000000; }

#pagina_historico { background-color: #000000; }
#ordem_historico,
#botao_atualizar_historico,
#botao_limpar_historico,
#botao_excluir_historico {
    background-color: #000000;
    color: #FFFF00;
    border-color: #FFFF00;
}
#ordem_historico:hover,
#botao_atualizar_historico:hover,
#botao_limpar_historico:hover,
#botao_excluir_historico:hover {
    background-color: #FFFF00;
    color: #000000;
}
#botao_atualizar_historico:disabled { color: #D4D400; }
#ordem_historico::down-arrow {
    image: url(interface/assets/chevron_down_contraste.svg);
}
#resumo_historico, #data_historico,
#comando_historico, #estado_historico { color: #FFFF00; }
#conteudo_historico, #lista_historico,
#item_historico {
    background-color: #000000;
    border-color: #FFFF00;
}
#lista_historico QScrollBar::handle:vertical { background-color: #FFFF00; }

#pagina_configuracoes,
#conteudo_configuracoes { background-color: #000000; }
#card_configuracao {
    background-color: #000000;
    border-color: #FFFF00;
}
#titulo_card_configuracao, #descricao_card_configuracao,
#label_configuracao, #valor_configuracao,
#status_configuracoes { color: #FFFF00; }
#scroll_configuracoes QScrollBar::handle:vertical {
    background-color: #FFFF00;
}
#campo_configuracao {
    background-color: #000000;
    color: #FFFF00;
    border-color: #FFFF00;
}
#campo_configuracao::down-arrow {
    image: url(interface/assets/chevron_down_contraste.svg);
}
#campo_configuracao QAbstractItemView {
    background-color: #000000;
    color: #FFFF00;
    selection-background-color: #FFFF00;
    selection-color: #000000;
    border: 1px solid #FFFF00;
}
#slider_configuracao::groove:horizontal { background-color: #FFFFFF; }
#slider_configuracao::sub-page:horizontal { background-color: #FFFF00; }
#slider_configuracao::handle:horizontal {
    background-color: #FFFF00;
    border-color: #000000;
}
#botao_secundario_configuracoes,
#botao_salvar_configuracoes {
    background-color: #000000;
    color: #FFFF00;
    border-color: #FFFF00;
}
#botao_secundario_configuracoes:hover,
#botao_salvar_configuracoes:hover {
    background-color: #FFFF00;
    color: #000000;
}

#pagina_inicio, #conteudo_inicio { background-color: #000000; }
#estado_assistente, #titulo_campo_audio { color: #FFFF00; }
#botao_microfone {
    background-color: #FFFF00;
    color: #000000;
    border-color: #FFFFFF;
}
#botao_microfone:hover { background-color: #FFFFFF; }
#card_audio_inicio {
    background-color: #000000;
    border-color: #FFFF00;
}
#campo_audio_inicio {
    background-color: #000000;
    color: #FFFF00;
    border-color: #FFFF00;
}
#campo_audio_inicio::down-arrow {
    image: url(interface/assets/chevron_down_contraste.svg);
}
#campo_audio_inicio QAbstractItemView {
    background-color: #000000;
    color: #FFFF00;
    selection-background-color: #FFFF00;
    selection-color: #000000;
    border: 1px solid #FFFF00;
}
#divisor_audio_inicio { background-color: #FFFF00; border: none; }
#botao_iniciar_assistente,
#botao_configuracoes_voz {
    background-color: #000000;
    color: #FFFF00;
    border-color: #FFFF00;
}
#botao_iniciar_assistente:hover,
#botao_configuracoes_voz:hover {
    background-color: #FFFF00;
    color: #000000;
}

#login_card { background-color: #000000; border-color: #FFFF00; }
QLineEdit { background-color: #000000; color: #FFFF00; border-color: #FFFF00; }

#btn_entrar { background-color: #FFFF00; color: #000000; }
#btn_entrar:hover { background-color: #D4D400; }

#subtitulo_login { color: #FFFF00; }
#logo_login { color: #FFFF00; }
